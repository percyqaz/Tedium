<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tedium</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TodoList\Tag.fs" />
    <Compile Include="TodoList\TodoItem.fs" />
    <Compile Include="TodoList\TodoItemParser.fs" />
    <Compile Include="TodoList\TodoItemWriter.fs" />
    <Compile Include="TodoList\TodoListRoot.fs" />
    <Compile Include="State\State.fs" />
    <Compile Include="Operations.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="InputThread.fs" />
    <Compile Include="InputBuffer.fs" />
    <Compile Include="ScreenBuffer.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Tedium.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>